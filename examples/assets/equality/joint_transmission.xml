<mujoco model="Joint transmission gallery">
  <!-- Three dials driven only through equality/joint rows.  The left dial is the
       input, the middle dial is the linear reference y = -0.8 x, and the right
       dial is the quartic output y = 0.6 x + 0.4 x^2 - 0.15 x^3 + 0.05 x^4.
       The equality transmits the motion law, so this is not a tooth-contact or
       belt transmission; no teeth or belts are drawn.  Gravity and contacts are
       off so the scene isolates the joint equality path. -->
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 0"/>
  <worldbody>
    <light type="directional" pos="-2.5 -3.0 4.0" dir="0.3 0.45 -0.84" diffuse="0.9 0.9 0.95"/>
    <light type="directional" pos="2.5 -2.0 3.0" dir="-0.25 0.4 -0.78" diffuse="0.35 0.38 0.45"/>

    <body name="gallery" pos="0 0 0">
      <geom type="box" pos="0 0 -0.055" size="2.05 0.62 0.055" rgba="0.06 0.08 0.11 1" contype="0" conaffinity="0"/>
      <!-- dark coloured trim rings identify the three stations -->
      <geom type="cylinder" pos="-1.45 0 0.003" size="0.60 0.004" rgba="0.05 0.30 0.36 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="0 0 0.003" size="0.60 0.004" rgba="0.34 0.22 0.05 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="1.45 0 0.003" size="0.60 0.004" rgba="0.32 0.05 0.22 1" contype="0" conaffinity="0"/>
      <!-- fixed index ticks: eight per station, with a taller top index -->
      <geom type="box" pos="-1.45 0.565 0.012" size="0.020 0.07 0.008" rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="-2.015 0 0.012" euler="0 0 1.5707963" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="-1.45 -0.565 0.012" euler="0 0 3.1415927" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="-0.885 0 0.012" euler="0 0 -1.5707963" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 0.565 0.012" size="0.020 0.07 0.008" rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="-0.565 0 0.012" euler="0 0 1.5707963" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 -0.565 0.012" euler="0 0 3.1415927" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="0.565 0 0.012" euler="0 0 -1.5707963" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="1.45 0.565 0.012" size="0.020 0.07 0.008" rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="2.015 0 0.012" euler="0 0 1.5707963" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="1.45 -0.565 0.012" euler="0 0 3.1415927" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="0.885 0 0.012" euler="0 0 -1.5707963" size="0.012 0.035 0.006" rgba="0.65 0.68 0.72 1" contype="0" conaffinity="0"/>
      <camera name="overview" pos="0 -3.6 1.6" xyaxes="1 0 0 0 0.395 0.918"/>

      <!-- cyan input dial -->
      <body name="input" pos="-1.45 0 0.10">
        <joint name="input_angle" type="hinge" axis="0 0 1" damping="0.05" armature="0.02"/>
        <geom type="cylinder" pos="0 0 -0.06" size="0.05 0.05" rgba="0.30 0.32 0.36 1" contype="0" conaffinity="0"/>
        <geom type="cylinder" size="0.50 0.035" mass="1.6" rgba="0.02 0.30 0.38 1" contype="0" conaffinity="0"/>
        <geom type="cylinder" pos="0 0 0.045" size="0.055 0.025" mass="0.12" rgba="0.10 0.55 0.62 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.055 0.44 0 0.055" size="0.026" mass="0.08" rgba="0.15 0.85 0.95 1" contype="0" conaffinity="0"/>
        <geom type="sphere" pos="0.44 0 0.055" size="0.052" mass="0.05" rgba="0.75 1 1 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.05 -0.30 0 0.05" size="0.020" mass="0.04" rgba="0.10 0.55 0.62 1" contype="0" conaffinity="0"/>
        <geom type="sphere" pos="-0.30 0 0.05" size="0.075" mass="0.18" rgba="0.03 0.45 0.52 1" contype="0" conaffinity="0"/>
      </body>

      <!-- amber linear reference dial: four-spoke rotor -->
      <body name="linear" pos="0 0 0.10">
        <joint name="linear_angle" type="hinge" axis="0 0 1" damping="0.02" armature="0.02"/>
        <geom type="cylinder" pos="0 0 -0.06" size="0.05 0.05" rgba="0.30 0.32 0.36 1" contype="0" conaffinity="0"/>
        <geom type="cylinder" size="0.50 0.035" mass="1.6" rgba="0.36 0.23 0.04 1" contype="0" conaffinity="0"/>
        <geom type="cylinder" pos="0 0 0.045" size="0.055 0.025" mass="0.12" rgba="0.62 0.42 0.10 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.05 0.44 0 0.05" size="0.024" mass="0.06" rgba="1 0.70 0.15 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.05 -0.34 0 0.05" size="0.018" mass="0.04" rgba="0.78 0.52 0.10 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.05 0 0.34 0.05" size="0.018" mass="0.04" rgba="0.78 0.52 0.10 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.05 0 -0.34 0.05" size="0.018" mass="0.04" rgba="0.78 0.52 0.10 1" contype="0" conaffinity="0"/>
        <geom type="sphere" pos="0.44 0 0.05" size="0.045" mass="0.04" rgba="1 0.92 0.60 1" contype="0" conaffinity="0"/>
      </body>

      <!-- magenta quartic output dial: pointer plus eccentric mass -->
      <body name="quartic" pos="1.45 0 0.10">
        <joint name="quartic_angle" type="hinge" axis="0 0 1" damping="0.02" armature="0.02"/>
        <geom type="cylinder" pos="0 0 -0.06" size="0.05 0.05" rgba="0.30 0.32 0.36 1" contype="0" conaffinity="0"/>
        <geom type="cylinder" size="0.50 0.035" mass="1.6" rgba="0.34 0.04 0.22 1" contype="0" conaffinity="0"/>
        <geom type="cylinder" pos="0 0 0.045" size="0.055 0.025" mass="0.12" rgba="0.62 0.12 0.42 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.055 0.44 0 0.055" size="0.024" mass="0.07" rgba="1 0.22 0.65 1" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0.05 -0.32 0 0.05" size="0.020" mass="0.04" rgba="0.75 0.10 0.40 1" contype="0" conaffinity="0"/>
        <geom type="sphere" pos="-0.32 0 0.05" size="0.085" mass="0.22" rgba="0.90 0.15 0.55 1" contype="0" conaffinity="0"/>
        <geom type="sphere" pos="0.44 0 0.055" size="0.045" mass="0.04" rgba="1 0.65 0.88 1" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- y = -0.8 x : linear reference -->
    <joint name="linear_transmission" joint1="linear_angle" joint2="input_angle"
           polycoef="0 -0.8 0 0 0" solref="0.002 1" solimp="0.99 0.99 0.001 0.5 2"/>
    <!-- y = 0.6 x + 0.4 x^2 - 0.15 x^3 + 0.05 x^4 : curved transmission -->
    <joint name="quartic_transmission" joint1="quartic_angle" joint2="input_angle"
           polycoef="0 0.6 0.4 -0.15 0.05" solref="0.002 1" solimp="0.99 0.99 0.001 0.5 2"/>
  </equality>

  <actuator>
    <position name="input_drive" joint="input_angle" kp="150" kv="8"/>
  </actuator>
</mujoco>
