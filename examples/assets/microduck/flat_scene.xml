<mujoco model="Microduck keyboard control">
  <!-- MJCF tolerance is square-rooted by MotrixSim: sqrt(1e-8) = 1e-4. -->
  <option timestep="0.005" iterations="6" tolerance="1e-8"/>
  <statistic center="0 0 0.12" extent="0.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="180" elevation="-20"/>
  </visual>
  <asset>
    <texture name="ground" type="2d" file="../common/motphys-ground.png"/>
    <material name="ground" texture="ground" texuniform="true" texrepeat="0.4 0.4"/>
    <texture type="skybox" builtin="gradient" rgb1="0.4314 0.5294 0.6431" rgb2="0 0 0" width="512" height="512"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.01" material="ground"
      friction="1 0.005 0.0001" priority="1" condim="3"/>
  </worldbody>
</mujoco>
